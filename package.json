{
  "name": "cb-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cloudbeds --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "test:cc": "node --experimental-sqlite test/commoncrawl.test.mjs",
    "db:migrate:cc": "wrangler d1 execute cloudbeds --remote --file=./migrations/0002_commoncrawl.sql"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
